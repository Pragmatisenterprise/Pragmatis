{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pragmatis",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "pragmatis", "migrations_dir": "migrations" }
  ],
  "vars": {
    "CONTACT_FROM": "Pragmatis <web@pragmatis.co>",
    "CONTACT_TO": "contacto@pragmatis.co"
  }
}
